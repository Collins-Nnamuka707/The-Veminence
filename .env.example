# Public URL of the site, used for canonical and hreflang links and Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact number for the footer WhatsApp link, in international format.
WHATSAPP_NUMBER=+48 000 000 000

# Stripe secret key (Dashboard > Developers > API keys). Use the TEST key (sk_test_...) until launch.
# Never commit the real value; keep it only in .env.local and in Vercel.
STRIPE_SECRET_KEY=

# Supabase project (Project Settings > API). The publishable key is safe in the browser.
# Never put the service role / secret key here with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
